# Copy these into Replit "Secrets" (Tools > Secrets) or a local .env

# Which image API to use: gemini (recommended / cheapest) or openai
PROVIDER=gemini

# --- Gemini (Google AI Studio) ---
GEMINI_API_KEY=your_google_ai_studio_key
# Override only if the model id changes:
GEMINI_MODEL=gemini-2.5-flash-image

# --- OpenAI (used only when PROVIDER=openai) ---
OPENAI_API_KEY=your_openai_key
OPENAI_MODEL=gpt-image-1

# Restrict who may call the proxy (or leave * while testing)
ALLOW_ORIGIN=*
