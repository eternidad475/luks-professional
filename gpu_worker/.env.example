# CaseFlow Studio — GPU Worker 環境変数
# =========================================
# 1. このファイルを .env にコピー: cp .env.example .env
# 2. 各値を記入
# 3. Modal シークレットを作成:
#      modal secret create caseflow-secrets \
#        R2_ENDPOINT="$R2_ENDPOINT" \
#        R2_ACCESS_KEY_ID="$R2_ACCESS_KEY_ID" \
#        R2_SECRET_ACCESS_KEY="$R2_SECRET_ACCESS_KEY" \
#        R2_BUCKET="$R2_BUCKET" \
#        UPSTASH_REDIS_REST_URL="$UPSTASH_REDIS_REST_URL" \
#        UPSTASH_REDIS_REST_TOKEN="$UPSTASH_REDIS_REST_TOKEN"

# ── Cloudflare R2 ─────────────────────────────────────────────────────────────
# Cloudflare Dashboard → R2 → Overview → アカウントID
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com

# R2 → Manage R2 API Tokens → Create API Token
# Permissions: Object Read & Write (バケット: caseflow-morphs のみ)
R2_ACCESS_KEY_ID=<R2_ACCESS_KEY_ID>
R2_SECRET_ACCESS_KEY=<R2_SECRET_ACCESS_KEY>

# 作成したバケット名（例: caseflow-morphs）
R2_BUCKET=caseflow-morphs

# ── Upstash Redis ──────────────────────────────────────────────────────────────
# console.upstash.com → Database → REST API タブ
UPSTASH_REDIS_REST_URL=https://<ID>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<TOKEN>
