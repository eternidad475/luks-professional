# CaseFlow Studio — GPU Worker Environment Variables
# =====================================================
# Copy this file to .env and fill in every value.
# Then run:  modal secret create caseflow-secrets $(cat .env | xargs)
# Or use the Modal dashboard to create a secret named "caseflow-secrets".

# ── Cloudflare R2 ─────────────────────────────────────────────────────────────
# 1. Go to https://dash.cloudflare.com → R2 → Create bucket
# 2. Bucket name: caseflow-morphs  (or any name you like)
# 3. Go to R2 → Manage R2 API Tokens → Create API Token
#    Permissions: Object Read & Write on your bucket

R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=<R2_ACCESS_KEY_ID>
R2_SECRET_ACCESS_KEY=<R2_SECRET_ACCESS_KEY>
R2_BUCKET=caseflow-morphs

# ── Upstash Redis ──────────────────────────────────────────────────────────────
# 1. Go to https://console.upstash.com → Create Database → Region: closest to GPU
# 2. Copy the REST URL and Token from "REST API" section

UPSTASH_REDIS_REST_URL=https://<ID>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<TOKEN>
